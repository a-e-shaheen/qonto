# Loaded by the Makefile for anything run directly on the host (`make run`,
# `make migrate-up`, `make migrate-down`) against the same docker-compose Postgres
# `.env` points the containerized app at — only the hostnames/ports differ
# (localhost + the host-mapped port, instead of the compose service name).

DB_DSN=postgres://qonto:qonto@localhost:5433/qonto?sslmode=disable
DB_MAX_CONNS=10

HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

MIGRATIONS_DIR=migrations
SEED_ON_STARTUP=true

OTEL_SERVICE_NAME=qonto-bulk-transfer-local
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=1
